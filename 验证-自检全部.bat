@echo off
title 自检全部（架构 / 逻辑 / 隐私 / 内存）
setlocal
set "ROOT=%~dp0"
call "%ROOT%tools\_python.bat"

if not defined PYEXE (
    echo [x] 没有找到 Python。请先双击 tools\install_deps.bat。
    pause
    exit /b 1
)
set "PY=%PYEXE%"

echo ================================================================
echo  第 1 步 / 4：架构约束检查（防屎山）
echo ================================================================
"%PY%" "%ROOT%tools\test_arch.py"

echo.
echo ================================================================
echo  第 2 步 / 4：逻辑与安全回归自测
echo ================================================================
"%PY%" "%ROOT%tools\selftest.py"

echo.
echo ================================================================
echo  第 3 步 / 4：隐私与安全自证（不联网 / 不采集内容）
echo ================================================================
"%PY%" "%ROOT%tools\audit.py"

echo.
echo ================================================================
echo  第 4 步 / 4：内存与 CPU 基准
echo     （如果监测程序还没启动，这一步会自己拉一个来测、测完关掉）
echo ================================================================
"%PY%" "%ROOT%tools\bench_mem.py" --seconds 16

echo.
echo 全部检查结束。
pause
